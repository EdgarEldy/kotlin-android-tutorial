<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed in debug builds only.
  The emulator connects to the host backend via 10.0.2.2:8080.
  Release builds will require HTTPS.
-->
<network-security-config>
    <!-- User certs trusted in debug for Charles/Proxyman MITM proxies -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
    <!-- HTTP allowed for local backend (emulator 10.0.2.2 and physical device via LAN IP).
         Phase 6 will tighten this to HTTPS only for release builds. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
